<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.camera" android:required="true" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/logomercadolibre"
        android:label="Mercado Libre Prueba"
        android:roundIcon="@mipmap/logomercadolibre_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PruebaMercadoPago"
        tools:targetApi="31"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".view.DetailsView"
            android:exported="false"
            android:theme="@style/Theme.PruebaMercadoPago"
            android:windowSoftInputMode="adjustPan"/>
        <activity
            android:name=".view.HomeView"
            android:exported="false"
            android:theme="@style/Theme.PruebaMercadoPago"
            android:windowSoftInputMode="adjustPan"/>
        <activity
            android:name=".view.SplashView"
            android:exported="true"
            android:label="Mercado Libre Prueba"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>